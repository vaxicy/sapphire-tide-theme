  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": "#245BB0",
    "method": "#245BB0",
    "class": "#66549D",
    "type": "#66549D",
    "string": "#28716E",
    "number": "#87652F",
    "keyword": "#4647AE",
    "comment": "#6B7F90"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#6B7F90"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#4647AE"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#28716E"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#87652F"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#66549D"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#245BB0"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#263750"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#4647AE"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#87652F"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#4647AE"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#AB4858"
      }
    }
  ]
}
