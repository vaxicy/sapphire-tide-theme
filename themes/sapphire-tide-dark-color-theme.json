  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": "#82B3FF",
    "method": "#82B3FF",
    "class": "#C0B3E6",
    "type": "#C0B3E6",
    "string": "#AACCD6",
    "number": "#D9C18F",
    "keyword": "#B1ACF0",
    "comment": "#8399AE"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#8399AE"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#B1ACF0"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#AACCD6"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#D9C18F"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#C0B3E6"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#82B3FF"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#DFEAF3"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#B1ACF0"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#EAC18C"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#B1ACF0"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#E69DA8"
      }
    }
  ]
